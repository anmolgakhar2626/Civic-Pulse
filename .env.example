# ==============================================================================
# CivicPulse Smart City Command Centre - Environment Configuration Template
# Copy this file to .env and configure secret values prior to deployment.
# NEVER commit .env to source control.
# ==============================================================================

# Core Services Ports
SERVER_PORT=8080
FRONTEND_PORT=5173
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379
MQTT_PORT=1883
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL + PostGIS Configuration
POSTGRES_DB=civicpulse_db
DATABASE_URL=jdbc:postgresql://localhost:5432/civicpulse_db
DATABASE_USERNAME=civicpulse
DATABASE_PASSWORD=your_secure_database_password

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/civicpulse
MONGO_DB=civicpulse

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Mosquitto MQTT Broker Configuration
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=civicpulse-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ENABLED=true

# Security & JWT Tokens
# Provide a 256-bit or 384-bit Base64-encoded secret key
JWT_SECRET=replace_with_your_own_secure_base64_jwt_secret_key_minimum_256_bits
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# External APIs (Open-Meteo Weather & Air Quality)
EXTERNAL_API_URLS=https://api.open-meteo.com/v1/forecast,https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# ==============================================================================
# SMS GATEWAY CONFIGURATION
# Set SMARTCITY_SMS_PROVIDER=mock for local demo mode:
# - Generates dynamic 6-digit OTPs
# - Prints OTP directly to backend terminal in ASCII banner
# - Writes OTP to backend/demo-otp.log (excluded from Git)
# Set SMARTCITY_SMS_PROVIDER=twilio for real SMS delivery in production
# ==============================================================================
SMARTCITY_SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
FAST2SMS_API_KEY=your_fast2sms_api_key_here
SMS_GATEWAY_URL=https://api.yourprovider.com/sms/send
SMS_GATEWAY_API_KEY=your_generic_sms_api_key_here
SMS_GATEWAY_SENDER_ID=CIVICPULSE

# Notification Channels Configuration (Optional)
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM_ADDRESS=notifications@civicpulse.smartcity.gov
SMS_NOTIFICATIONS_ENABLED=false
